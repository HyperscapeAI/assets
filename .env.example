# HyperScape Assets Server Configuration
# Copy this file to .env and customize as needed
# Environment variables override values in config.json

# ===================================
# Server Configuration
# ===================================
# Port number (1-65535)
# Defaults to 3000, but Railway/cloud deployments typically set PORT automatically
PORT=3000

# Host address
# Use 0.0.0.0 to listen on all interfaces (required for cloud deployments)
HOST=localhost

# ===================================
# CORS Configuration
# ===================================
# Allowed origins (comma-separated list)
# Use * to allow all origins, or specify specific domains
# Example: https://example.com,https://app.example.com
CORS_ORIGINS=*

# ===================================
# Security Configuration
# ===================================
# Maximum file upload size in bytes
# Default: 104857600 (100MB)
MAX_FILE_SIZE=104857600

# Enable authentication (true/false)
# Default: false
ENABLE_AUTH=false

# ===================================
# Notes
# ===================================
# - Environment variables take precedence over config.json settings
# - Only the variables listed above are currently supported
# - For other configuration options, use the dashboard settings UI or edit config.json directly
# - Restart the server after changing environment variables
