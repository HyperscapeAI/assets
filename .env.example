# HyperScape Assets Server Configuration
# Copy this file to .env and customize as needed
# Environment variables override values in config.json

# ===================================
# Server Configuration
# ===================================
# Port number (1-65535)
# Defaults to 3000, but Railway/cloud deployments typically set PORT automatically
PORT=3000

# Host address
# Use 0.0.0.0 to listen on all interfaces (required for cloud deployments)
HOST=localhost

# ===================================
# Volume Configuration (Railway/Cloud)
# ===================================
# Data directory for persistent storage
# Set to /data for Railway volume mount
# Defaults to project root for local development
DATA_DIR=/data

# ===================================
# CORS Configuration
# ===================================
# Allowed origins (comma-separated list)
# Use * to allow all origins, or specify specific domains
# Example: https://example.com,https://app.example.com
CORS_ORIGINS=*

# ===================================
# Security Configuration
# ===================================
# Maximum file upload size in bytes
# Default: 104857600 (100MB)
MAX_FILE_SIZE=104857600

# ===================================
# Authentication Configuration
# ===================================
# Admin username for dashboard access
# If both ADMIN_USERNAME and ADMIN_PASSWORD are set, authentication is AUTOMATICALLY enabled
ADMIN_USERNAME=admin

# Admin password for dashboard access
# IMPORTANT: Use a strong password in production!
ADMIN_PASSWORD=your-secure-password-here

# Session secret for cookie signing (optional, auto-generated if not provided)
# SESSION_SECRET=your-random-secret-string

# Session duration in hours (default: 24)
SESSION_DURATION_HOURS=24

# ===================================
# Notes
# ===================================
# - Environment variables take precedence over config.json settings
# - Authentication is enabled automatically when ADMIN_USERNAME and ADMIN_PASSWORD are both set
# - Use DATA_DIR=/data when deploying to Railway with a volume attached
# - For other configuration options, use the dashboard settings UI or edit config.json directly
# - Restart the server after changing environment variables
